# Copy this file to .env and fill in your Razorpay credentials.
# .env is gitignored and must never be committed to source control.
#
# Test Mode keys look like rzp_test_... (Razorpay Dashboard -> Settings -> API Keys)
# Live Mode keys look like rzp_live_...

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
